{
    "name": "horde/horde",
    "description": "Horde base application",
    "type": "horde-application",
    "homepage": "https://www.horde.org/apps/horde",
    "license": "LGPL-2.0-only",
    "authors": [
        {
            "name": "Jan Schneider",
            "email": "jan@horde.org",
            "role": "lead"
        },
        {
            "name": "Michael J Rubinsky",
            "email": "mrubinsk@horde.org",
            "role": "lead"
        },
        {
            "name": "Michael Slusarz",
            "email": "slusarz@horde.org",
            "role": "lead"
        },
        {
            "name": "Chuck Hagenbuch",
            "email": "chuck@horde.org",
            "role": "lead"
        }
    ],
    "time": "2026-07-09",
    "repositories": [],
    "require": {
        "horde/horde-installer-plugin": "^3 || ^2",
        "php": "^8.1",
        "horde/alarm": "^3.0.0",
        "horde/argv": "^3.0.0",
        "horde/auth": "^3.0.0",
        "horde/autoloader": "^3.0.0",
        "horde/browser": "^3.0.0",
        "horde/core": "^3.2.0",
        "horde/cache": "^3.0.0",
        "horde/date": "^3.0.0",
        "horde/exception": "^3.0.1",
        "horde/form": "^3.1.2",
        "horde/group": "^3.0.0",
        "horde/hordeymlfile": "^1.0.0",
        "horde/http": "^3.0.0",
        "horde/identity": "^1.0.0",
        "horde/image": "^3.0.0",
        "horde/logintasks": "^3.0.0",
        "horde/mail": "^3.0.0",
        "horde/mime": "^3.0.0",
        "horde/nls": "^3.0.0",
        "horde/perms": "^3.1.0",
        "horde/prefs": "^3.0.1",
        "horde/rpc": "^3.0.0",
        "horde/serialize": "^3.0.0",
        "horde/support": "^3.0.0",
        "horde/text_diff": "^3.0.0",
        "horde/token": "^3.0.0",
        "horde/text_filter": "^3.0.0",
        "horde/tree": "^3.0.0",
        "horde/url": "^3.0.0",
        "horde/util": "^3.0.1",
        "horde/view": "^3.0.0",
        "horde/vfs": "^3.0.1",
        "php81_bc/strftime": "^0.7",
        "horde/db": "^3.0.0",
        "horde/oauth": "^4.0.0",
        "horde/secret": "^3.0.0",
        "ext-filter": "*",
        "ext-gettext": "*",
        "ext-mbstring": "*",
        "ext-hash": "*",
        "ext-intl": "*"
    },
    "require-dev": {
        "horde/test": "^3.0.0"
    },
    "suggest": {
        "mikepultz/netdns2": "^2.0",
        "horde/activesync": "^3.0.2",
        "horde/backup": "^2.0.0",
        "horde/cli_application": "^2.0.1",
        "horde/feed": "^3.0.0",
        "horde/openxchange": "^2.0.0",
        "horde/service_facebook": "^3.0.0alpha2@alpha",
        "horde/service_twitter": "^3.0.0",
        "horde/service_weather": "^3.0.0alpha5@alpha",
        "horde/syncml": "^3.0.0alpha4@alpha",
        "ext-iconv": "*"
    },
    "autoload": {
        "classmap": [
            "lib/"
        ],
        "psr-4": {
            "Horde\\Horde\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Horde\\Horde\\Test\\": "test/"
        }
    },
    "bin": [
        "bin/horde-active-sessions",
        "bin/horde-alarms",
        "bin/horde-backup",
        "bin/horde-check-logger",
        "bin/horde-clear-cache",
        "bin/horde-crond",
        "bin/horde-db-migrate",
        "bin/horde-import-openxchange-prefs",
        "bin/horde-import-squirrelmail-prefs",
        "bin/horde-memcache-stats",
        "bin/horde-pref-remove",
        "bin/horde-queue-run-tasks",
        "bin/horde-remove-user-data",
        "bin/horde-run-task",
        "bin/horde-sessions-gc",
        "bin/horde-set-perms",
        "bin/horde-setup",
        "bin/horde-sql-shell",
        "bin/horde-themes",
        "bin/horde-translation"
    ],
    "config": {
        "allow-plugins": {
            "horde/horde-installer-plugin": true
        }
    },
    "provide": {
        "horde/base": "^6"
    },
    "extra": {
        "branch-alias": {
            "dev-FRAMEWORK_6_0": "6.x-dev"
        }
    }
}