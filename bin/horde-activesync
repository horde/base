use Horde\Cli\Cli;
use Horde\Horde\Cli\ActiveSync\CommandRunner;

require_once __DIR__ . '/../lib/Application.php';
Horde_Registry::appInit('horde', [
    'authentication' => 'none',
    'cli' => true,
]);

$runner = new CommandRunner(new Cli(), $injector);
exit($runner->run(array_slice($argv, 1)));
